{
    "version": "0.2.0",
    "configurations": [
        
      {
        "name": "Debug C++ Program",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/a.out",  // Change to your compiled program's path
        "args": [],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "environment": [],
        "externalConsole": false,  // Set to true if you want an external terminal
        "MIMode": "gdb",
        "setupCommands": [
          {
            "description": "Enable pretty-printing for gdb",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
          }
        ],
        "miDebuggerPath": "/usr/bin/gdb",  // Path to GDB, usually /usr/bin/gdb
        "preLaunchTask": "build",  // Optional: if you have a build task
        "logging": {
          "moduleLoad": false
        }
      }
    ]
  }
  